# Service identity (included in health responses)
SERVICE_NAME=ai-knowledge-hub-api

# Comma-separated CORS allowlist (no wildcards)
CORS_ORIGINS=http://localhost:3000

# Uvicorn bind options
API_HOST=0.0.0.0
API_PORT=8000

# Database (optional overrides — defaults load from repo root .env POSTGRES_*)
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
# POSTGRES_HOST=127.0.0.1
# DATABASE_CONNECT_TIMEOUT=5

# JWT authentication (Neon Managed Better Auth — required for protected routes)
# Obtain jwks_url and base_url from the Neon Auth API or console when enabling auth.
# Docs: https://neon.com/docs/auth/guides/plugins/jwt
# AUTH_JWKS_URL=<jwks_url from Neon, typically .../.well-known/jwks.json>
# AUTH_ISSUER=<origin of base_url, e.g. new URL(base_url).origin per Neon docs>
# AUTH_AUDIENCE=optional-if-present-in-tokens
# AUTH_JWKS_CACHE_TTL_SECONDS=300
# AUTH_JWKS_REQUEST_TIMEOUT_SECONDS=10
