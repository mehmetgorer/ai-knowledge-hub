# Service identity (included in health responses)
SERVICE_NAME=ai-knowledge-hub-api

# Comma-separated CORS allowlist (no wildcards)
CORS_ORIGINS=http://localhost:3000

# Uvicorn bind options
API_HOST=0.0.0.0
API_PORT=8000

# Database (optional overrides — defaults load from repo root .env POSTGRES_*)
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
# POSTGRES_HOST=127.0.0.1
# DATABASE_CONNECT_TIMEOUT=5

# JWT authentication (Neon Managed Better Auth — required for protected routes)
# Neon Console → Branch → Auth → Configuration. See:
# https://neon.com/docs/auth/guides/plugins/jwt
#
# AUTH_JWKS_URL — JWKS URL from Neon (Auth URL + /.well-known/jwks.json)
# AUTH_ISSUER — origin of NEON_AUTH_BASE_URL (scheme + host only, no /neondb/auth path)
#               Example: https://ep-xxx.neonauth.us-east-1.aws.neon.tech
# AUTH_AUDIENCE — set to the same origin as AUTH_ISSUER when Neon JWTs include aud
#                 (default Neon JWT payload uses aud = issuer origin)
# AUTH_JWKS_URL=
# AUTH_ISSUER=
# AUTH_AUDIENCE=
# AUTH_JWKS_CACHE_TTL_SECONDS=300
# AUTH_JWKS_REQUEST_TIMEOUT_SECONDS=10
