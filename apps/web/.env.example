# Neon Managed Better Auth (Next.js). Copy to `.env.local` — never commit secrets.
# Auth URL: Neon Console → Project → Branch → Auth → Configuration (Settings / Project Info).
# See https://neon.com/docs/auth/quick-start/nextjs-api-only

NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/auth
# At least 32 characters — generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# FastAPI base URL for browser calls (local development only)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
